# ============================================================
# Chicken Price Manager - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.

# MongoDB Atlas connection string
# 1. Go to https://cloud.mongodb.com
# 2. Create a free M0 cluster
# 3. Create a database user with read/write access
# 4. Get the connection string (choose "Connect your application" > Node.js)
# 5. Replace <password> with your database user's password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chicken-price-manager?retryWrites=true&w=majority

# NextAuth.js secret key
# Generate one with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your-super-secret-key-here

# NextAuth.js URL
# In development: http://localhost:3000
# In production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
